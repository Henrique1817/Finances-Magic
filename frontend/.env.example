# URL do backend Express (só origem + porta, sem /api/v1 e sem barra final).
# Next em :3000 → API normalmente em :3001 (não use a porta do Next aqui).
# Ex.: Docker com -p 3001:3000 → http://localhost:3001
# Produção: https://code-chroma-api.onrender.com — após deploy, GET /api/v1/ deve listar "auth".
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Se "true", usa sempre Whisper no simulador (mesmo no Chrome). Útil para testes.
# NEXT_PUBLIC_SPEECH_FORCE_WHISPER=true

# Login com Google (fluxo na API):
# 1) Render/API: FRONTEND_ORIGINS deve incluir a origem deste site (ex. https://xxx.vercel.app)
# 2) Render: PUBLIC_API_BASE_URL = URL pública da API
# 3) Supabase → Authentication → URL Configuration → Redirect URLs:
#      https://SUA-API/api/v1/auth/oauth/callback
# 4) Google Cloud → OAuth Client → Authorized redirect URIs:
#      https://SEU_REF.supabase.co/auth/v1/callback
