# URL do backend Express (só origem + porta, sem /api/v1 e sem barra final).
# Next em :3000 → API normalmente em :3001 (não use a porta do Next aqui).
# Ex.: Docker com -p 3001:3000 → http://localhost:3001
# Produção: https://code-chroma-api.onrender.com — após deploy, GET /api/v1/ deve listar "auth".
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Neon Auth (OAuth Google / refresh via cookie no browser)
# Mesmo URL do backend NEON_AUTH_URL (Console Neon → Auth → Configuration)
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-bold-frog-afobtxij.neonauth.c-2.us-west-2.aws.neon.tech/neondb/auth

# Se "true", usa sempre Whisper no simulador (mesmo no Chrome). Útil para testes.
# NEXT_PUBLIC_SPEECH_FORCE_WHISPER=true

# Login com Google:
# 1) Render/API: FRONTEND_ORIGINS + NEON_AUTH_TRUSTED_ORIGIN = origem deste site
# 2) Neon Auth → trusted_origins: mesma origem do front
# 3) Google OAuth já vem em modo shared no Neon Auth (sem client secret próprio)
