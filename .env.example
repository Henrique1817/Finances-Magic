# PostgreSQL (Prisma)
# --- Local (Postgres na máquina / Docker): pode repetir o mesmo valor nas duas linhas ---

#
# --- Supabase (Dashboard → Project Settings → Database → Connection string → URI) ---
# DATABASE_URL = modo "Transaction" / pooler (porta 6543), termina com ?pgbouncer=true
# DIRECT_URL   = "Direct connection" (porta 5432, host db.xxxxx.supabase.co)
# Exemplo (substituir PROJECT, PASSWORD, região):
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# --- Se a API corre em Docker ---
# Dentro do container, "localhost" é o próprio container. Postgres no Windows/host:
#   DATABASE_URL="postgresql://USER:PASSWORD@host.docker.internal:5432/code_chroma?schema=public"
# Postgres noutro serviço Compose: use o hostname do serviço (ex.: postgres://...@db:5432/...).
#
# Publique a API numa porta que bata certo com o front. Ex.: mapear 3001 no host → 3000 no container:
#   -p 3001:3000
# e no frontend: NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Se mapeares -p 3000:3000, o browser deve usar :3000 — mas aí conflita com Next.js na mesma porta.

# Supabase Auth — validação de JWT no backend (Project Settings → API)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Servidor HTTP
PORT=3000
NODE_ENV=development

# Log (pino): trace | debug | info | warn | error | fatal
# LOG_LEVEL=debug

# Fase 2 — ingestão (opcionais: workers pulam o provedor se ausente)
ALPHA_VANTAGE_API_KEY=
# ALPHA_VANTAGE_USE_MOCK=true
FRED_API_KEY=
NEWS_API_KEY=

# Cron: marketData seg–sex 18:30; newsAnalysis todo dia 08:00 (fuso abaixo)
CRON_TZ=America/Sao_Paulo
# INGESTION_CRON_ENABLED=false

# CORS: origens do front (separadas por vírgula). Padrão inclui localhost:5173 e :3000
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
