# PostgreSQL (Prisma)
# --- Local (Postgres na máquina / Docker): pode repetir o mesmo valor nas duas linhas ---

#
# --- Supabase (Dashboard → Connect) ---
# DATABASE_URL = Transaction pooler, porta 6543 + ?pgbouncer=true (runtime da app)
# DIRECT_URL   = migrações Prisma (conexão sem pooler quando possível).
#
# --- Neon (recomendado) ---
# DATABASE_URL = pooled  (host com "-pooler", sslmode=require)
# DIRECT_URL   = direct  (mesmo host sem "-pooler", sslmode=require)
# Console: https://console.neon.tech
#
# --- Supabase (legado) ---
# DATABASE_URL = Transaction pooler :6543 + ?pgbouncer=true
# DIRECT_URL   = Session pooler :5432 (IPv4) ou Direct db.*.supabase.co
# Exemplo:
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Se a API corre em Docker ---
# Dentro do container, "localhost" é o próprio container. Postgres no Windows/host:
#   DATABASE_URL="postgresql://USER:PASSWORD@host.docker.internal:5432/code_chroma?schema=public"
# Postgres noutro serviço Compose: use o hostname do serviço (ex.: postgres://...@db:5432/...).
#
# Publique a API numa porta que bata certo com o front. Ex.: mapear 3001 no host → 3000 no container:
#   -p 3001:3000
# e no frontend: NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Se mapeares -p 3000:3000, o browser deve usar :3000 — mas aí conflita com Next.js na mesma porta.

# Supabase Auth — validação de JWT no backend (Project Settings → API)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Servidor HTTP
PORT=3000
NODE_ENV=development

# Log (pino): trace | debug | info | warn | error | fatal
# LOG_LEVEL=debug

# --- Chaves de APIs externas (onde obter: ver README.md → "Onde obter as chaves de API") ---
# Fase 2 — ingestão (opcionais: workers pulam o provedor se ausente)
BRAPI_TOKEN=
ALPHA_VANTAGE_API_KEY=
# ALPHA_VANTAGE_USE_MOCK=true
FRED_API_KEY=
NEWS_API_KEY=
# Python executável para fallback yfinance (opcional; padrão: python)
# YFINANCE_PYTHON_EXECUTABLE=python
# Fontes adicionais 100% gratuitas usadas como fallback (sem chave):
# - Yahoo Finance (chart endpoint)
# - Stooq (CSV diário)
# - GDELT (news)
# - Google News RSS (news)
# - World Bank Indicators (macro anual)

# Transcrição por voz (OpenAI Whisper) + cenários IA (OpenAI Chat)
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
# Modelo barato e capaz para JSON financeiro / narrativas (padrão recomendado)
# OPENAI_MODEL=gpt-4o-mini
# Fallback opcional (só se o principal falhar; custo um pouco maior):
# OPENAI_MODEL_FALLBACKS=gpt-4.1-mini
# Caps diários por modelo (controle de custo):
# OPENAI_MODEL_DAILY_CAPS=gpt-4o-mini:200,gpt-4.1-mini:80
# Testes sem custo (não chama OpenAI real): true | false
# OPENAI_USE_MOCK=true
# Auto-geração de cenários para treino supervisionado contínuo (consome cota OpenAI):
# AI_AUTO_TRAINING_ENABLED=true
# AI_AUTO_TRAINING_MAX_SCENARIOS_PER_DAY=12
# AI_AUTO_TRAINING_MAX_USERS_PER_RUN=12

# Regiões climáticas para o worker Open-Meteo (sem chave — API pública). Chaves em src/config/ingestion.ts → CLIMATE_REGION_PRESETS
# CLIMATE_REGION_KEYS=SP_CAPITAL,BRASILIA

# Cron: marketData todo dia 18:30; newsAnalysis todo dia 08:00; clima todo dia 07:15;
# cotações 30m só para ativos em carteiras a cada 10 min (fuso abaixo)
CRON_TZ=America/Sao_Paulo
# INGESTION_CRON_ENABLED=false

# Agente diário de descoberta de parâmetros (ativos) por notícias:
# DAILY_PARAM_AGENT_ENABLED=true
# DAILY_PARAM_AGENT_USE_OPENAI=true
# DAILY_PARAM_AGENT_OPENAI_MODEL=gpt-4o-mini
# Limite duro diário de chamadas OpenAI desse agente:
# DAILY_PARAM_AGENT_OPENAI_DAILY_CAP=3
# Máx. de novos ativos aceitos por execução:
# DAILY_PARAM_AGENT_MAX_NEW_ASSETS_PER_RUN=12
# Quantas manchetes recentes analisar por execução:
# DAILY_PARAM_AGENT_NEWS_LOOKBACK=200

# Cotações “quentes” (Yahoo 30m) apenas para ativos ligados a posições (wallet_assets.asset_id).
# Ativos só no catálogo sem uso em carteiras não consomem pedidos. Padrão: ativo.
# USER_ASSET_PRICE_INGEST_ENABLED=false
# Intervalo mínimo entre atualizações por ativo (ms). Padrão 1_800_000 = 30 min.
# USER_ASSET_PRICE_MIN_INTERVAL_MS=1800000
# Máximo de ativos por execução do worker (rajada controlada).
# USER_ASSET_PRICE_MAX_PER_RUN=40
# Pausa entre pedidos Yahoo neste pipeline (ms).
# USER_ASSET_PRICE_REQUEST_GAP_MS=550

# CORS: origens do front (sem barra final; separadas por vírgula). Padrão inclui localhost:5173 e :3000
# Em produção inclua o domínio exato do Next/Vercel, ex.:
# FRONTEND_ORIGINS=https://finances-magic.vercel.app,http://localhost:3000
# localhost e 127.0.0.1 são espelhados na API; previews Vercel (*.vercel.app) opcional:
# CORS_ALLOW_VERCEL_PREVIEWS=true
#
# URL pública desta API (OAuth Google / redirect Supabase). Use o URL do Render (ou outro host).
# PUBLIC_API_BASE_URL=https://code-chroma-api.onrender.com
#
# Supabase → Authentication → Redirect URLs: acrescente
#   {PUBLIC_API_BASE_URL}/api/v1/auth/oauth/callback

CODECHROMA_SECRET=secret
