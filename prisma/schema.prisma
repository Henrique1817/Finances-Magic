// Code Chroma — MVP: modelo relacional para séries temporais e ingestão diária
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

/// Usuário autenticado via Supabase Auth (`sub` do JWT = este id)
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())

  wallet    Wallet?
  scenarios Scenario[]

  @@map("users")
}

/// Cenário de simulação IA guardado (mensagem + resultado quant + narrativa)
model Scenario {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  title      String
  message    String   @db.Text
  resultJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcomes ScenarioOutcome[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("scenarios")
}

/// Outcome supervisionado da previsão IA por cenário/ativo/horizonte (D+N)
model ScenarioOutcome {
  id                    String   @id @default(cuid())
  outcomeKey            String   @unique
  scenarioId            String
  walletAssetId         String?
  assetSymbol           String
  horizonDays           Int
  predictedReturn       Decimal  @db.Decimal(20, 8)
  predictedDirection    Int
  baselineDate          DateTime @db.Date
  baselineClose         Decimal  @db.Decimal(20, 8)
  targetDate            DateTime @db.Date
  actualReturn          Decimal? @db.Decimal(20, 8)
  actualDirection       Int?
  directionHit          Boolean?
  absoluteError         Decimal? @db.Decimal(20, 8)
  absolutePctError      Decimal? @db.Decimal(20, 8)
  status                String   @default("pending")
  evaluatedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([horizonDays, status, targetDate(sort: Asc)])
  @@index([assetSymbol, horizonDays, status])
  @@index([scenarioId, horizonDays])
  @@map("scenario_outcomes")
}

/// Carteira 1:1 com o usuário
model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAssets WalletAsset[]

  @@map("wallets")
}

/// Posição na carteira (nome livre; `assetId` opcional = vínculo ao catálogo)
model WalletAsset {
  id             String   @id @default(cuid())
  walletId       String   @db.Uuid
  assetId        String?
  nome           String
  setor          String
  valorInvestido Decimal  @db.Decimal(20, 2)
  quantidade     Decimal  @db.Decimal(24, 8)
  createdAt      DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  asset  Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@map("wallet_assets")
}

/// Ativos monitorados (ações tech, commodities, energia, etc.)
model Asset {
  id          String    @id @default(cuid())
  symbol      String    @unique
  name        String
  /// Agrupamento para o motor de correlação (ex.: Tech, Commodities, Index).
  category    String    @default("Other")
  type        AssetType
  issuerName  String?
  exchange    String?
  isin        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  priceHistory AssetPriceHistory[]
  walletAssets WalletAsset[]

  @@map("assets")
}

enum AssetType {
  STOCK
  COMMODITY
  ENERGY
  INDEX
  OTHER
}

/// Série temporal: fechamento diário por ativo (ingestão Alpha Vantage / outras fontes)
model AssetPriceHistory {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime @db.Date
  close     Decimal  @db.Decimal(20, 8)
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date(sort: Desc)])
  @@map("asset_price_history")
}

/// Observações macroeconômicas (FRED e similares): uma linha por série + data
model MacroIndicator {
  id        String   @id @default(cuid())
  seriesId  String
  name      String
  date      DateTime @db.Date
  value     Decimal  @db.Decimal(24, 8)
  createdAt DateTime @default(now())

  @@unique([seriesId, date])
  @@index([seriesId, date(sort: Desc)])
  @@map("macro_indicators")
}

/// Notícias ingeridas (ex.: NewsAPI) — contexto de risco / IA
model NewsRecord {
  id          String   @id @default(cuid())
  title       String
  source      String
  publishedAt DateTime
  url         String   @unique
  description String?  @db.Text
  externalId  String?
  summary     String?  @db.Text
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt(sort: Desc)])
  @@map("news_records")
}

/// Série diária de clima (Open-Meteo archive) por região lógica
model ClimateObservation {
  id        String   @id @default(cuid())
  regionKey String
  date      DateTime @db.Date
  tempMeanC Decimal? @db.Decimal(10, 4)
  precipMm  Decimal? @db.Decimal(12, 4)
  source    String
  createdAt DateTime @default(now())

  @@unique([regionKey, date])
  @@index([regionKey, date(sort: Desc)])
  @@map("climate_observations")
}

/// Execução de job de ingestão (auditoria)
model IngestionRun {
  id             String    @id @default(cuid())
  jobName        String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String
  rowsUpserted   Int       @default(0)
  error          String?   @db.Text

  @@index([jobName, startedAt(sort: Desc)])
  @@map("ingestion_runs")
}

/// Consumo agregado por provedor/janela para controle de quota
model ApiQuotaCounter {
  id          String   @id @default(cuid())
  provider    String
  window      String
  windowStart DateTime
  requests    Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([provider, window, windowStart])
  @@index([provider, windowStart(sort: Desc)])
  @@map("api_quota_counters")
}

/// Auditoria de fallback entre provedores de ingestão
model ProviderFallbackEvent {
  id               String   @id @default(cuid())
  pipeline         String
  fromProvider     String
  toProvider       String
  reason           String
  context          String?
  sourceStatusCode Int?
  createdAt        DateTime @default(now())

  @@index([pipeline, createdAt(sort: Desc)])
  @@index([fromProvider, createdAt(sort: Desc)])
  @@map("provider_fallback_events")
}

/// Rastreio por item ingerido (sucesso/erro/limite)
model IngestionItemStatus {
  id           String   @id @default(cuid())
  runId        String?  @db.Text
  jobName      String
  provider     String
  itemType     String
  itemKey      String
  status       String
  reason       String?
  httpStatus   Int?
  rowsUpserted Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([jobName, createdAt(sort: Desc)])
  @@index([provider, createdAt(sort: Desc)])
  @@index([itemType, itemKey])
  @@map("ingestion_item_status")
}

/// Snapshot opcional de exposição a fatores (JSON) para evolução futura
model FactorExposureSnapshot {
  id         String   @id @default(cuid())
  asOfDate   DateTime @db.Date
  windowDays Int
  payload    Json
  createdAt  DateTime @default(now())

  @@index([asOfDate(sort: Desc)])
  @@map("factor_exposure_snapshots")
}
